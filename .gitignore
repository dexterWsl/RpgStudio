# ===============================================================
# rpgStudio 的忽略规则
#   带开头 / 的只匹配仓库根目录，避免误伤子目录里同名的东西
# ===============================================================

# ---- 本地数据（每个人自己的，不进仓库）----
/data/*
!/data/.keep
/app/studio/data/
/backups/
/logs/

# ---- 运行环境：自带的 Node.js ----
#   体积 80 多 MB，不进仓库；打包时由 tools/build-release.js 下载后塞进发布包
/runtime/

# ---- 依赖 ----
/node_modules/

# ---- 发布产物 ----
/dist/
/dist-lite/

# ---- 草稿：还没定稿，先不进仓库 ----
#   要提交时删掉对应那一行，或者 git add -f <路径>
/demo/
/tools/pack-demo.js
/docs/演示文案-风见村.md

# ---- 编辑器写盘时的临时文件 ----
*.log
*.tmp
*.tmp-*
*.part-*
/data/.write-test-*

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
